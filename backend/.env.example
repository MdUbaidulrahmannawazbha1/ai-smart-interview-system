# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=AI Smart Interview System
VERSION=1.0.0
DEBUG=True

# CORS Settings
CORS_ORIGINS=["*"]

# ML Model Settings
MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
MAX_SEQUENCE_LENGTH=512

# Interview Settings
MAX_QUESTIONS=10
TIME_LIMIT_PER_QUESTION=300

# Scoring Thresholds
MIN_SIMILARITY_SCORE=0.3
EXCELLENT_THRESHOLD=0.8
GOOD_THRESHOLD=0.6
AVERAGE_THRESHOLD=0.4
